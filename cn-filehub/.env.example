# Copy to .env (NEVER commit .env). Keep this file outside the web root's public/ folder.
APP_ENV=local                       # local | production (production = HTTPS-only cookies + HSTS)
APP_URL=http://localhost:8000       # used for the email-verification redirect
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only secret, bypasses RLS
ALLOWED_EMAIL_DOMAIN=plm.edu.ph
TRUST_PROXY=false                   # true only if behind a proxy you control (uses X-Forwarded-For)
