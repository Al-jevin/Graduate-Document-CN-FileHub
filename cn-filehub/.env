APP_ENV=local
APP_URL=http://localhost/cn-filehub/public

# Base project URL only (no /rest/v1/ at the end)
SUPABASE_URL=https://mmeozcwcrnmbvftidogr.supabase.co
SUPABASE_ANON_KEY=
# Server-side only. Bypasses all security rules. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

STORAGE_BUCKET=student-documents
MAX_UPLOAD_MB=10
SESSION_LIFETIME_MINUTES=60

# Demo mode: Forgot Password goes straight from email to the Reset Password page (no OTP).
DEMO_PASSWORD_RESET=true

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Optional (Windows/Laragon): path to cacert.pem if cURL reports an SSL certificate error
CURL_CA_BUNDLE=C:/laragon/etc/ssl/cacert.pem